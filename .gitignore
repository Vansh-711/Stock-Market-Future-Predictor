# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# --- Secrets (never commit API keys) ---
.env
.env.*
!.env.example

# --- Archives / handoff zips ---
*.zip

# --- Python / Django (backend/) ---
backend/venv/
backend/.venv/
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
backend/db.sqlite3
backend/staticfiles/
backend/media/

# Downloaded news datasets (large; re-download locally)
backend/data/*.json
backend/data/*.jsonl
backend/data/*.csv

# Regenerated at runtime (yfinance + train_model)
backend/market/data/_price_cache/
backend/market/data/_model/model.joblib

# --- Node / Vite (frontend workspace) ---
**/node_modules/
**/dist/
**/.vite/
**/coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript build info (regenerated)
**/*.tsbuildinfo

